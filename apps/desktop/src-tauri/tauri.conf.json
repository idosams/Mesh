{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mesh",
  "version": "0.1.0",
  "identifier": "dev.mesh.desktop",
  "build": {
    "beforeBuildCommand": "npm run ui:next:build:island",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mesh — Local workspace",
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
