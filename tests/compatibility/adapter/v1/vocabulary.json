{
  "contract": "mesh-workspace-adapter/1",
  "extends": "mesh-workspace-adapter/0",
  "design": "01M0E2ZW2VPM66R1FZXQRR2CV5",
  "task": "01KZM96X4Y849Y23CC2SDX212H",
  "capabilities": [
    "Lookup",
    "Enumerate",
    "Open",
    "Read",
    "Write",
    "SetFileLength",
    "CreateFile",
    "CreateDirectory",
    "Rename",
    "Move",
    "Unlink",
    "RemoveDirectory",
    "ReadMetadata",
    "WriteMetadata",
    "MountActorView",
    "MaterializeReadonlyView",
    "ObserveDurableBoundary",
    "Symlink"
  ],
  "errors": [
    "Unsupported",
    "NotFound",
    "AlreadyExists",
    "NotADirectory",
    "IsADirectory",
    "DirectoryNotEmpty",
    "NameRejected",
    "OutsideWorkspace",
    "ReadOnly",
    "UnknownView",
    "WouldCycle",
    "Backend"
  ],
  "event_kinds": [
    "Opened",
    "Written",
    "Flushed",
    "Synced",
    "Closed",
    "Renamed",
    "Unlinked",
    "MetadataChanged"
  ],
  "rename_dispositions": ["Fail", "Replace"],
  "rename_evidence": {
    "carrier": "separate-evidence-object",
    "event_key": ["view", "sequence"],
    "cardinality": "zero-or-one",
    "fields": [
      "source_before.parent",
      "source_before.name",
      "source_before.object",
      "destination_before.state",
      "destination_before.object",
      "destination_after.parent",
      "destination_after.name",
      "destination_after.object"
    ],
    "outcomes": ["Available", "Unsupported"],
    "unsupported_code": "rename-binding-evidence-unavailable",
    "guessing": "forbidden"
  },
  "identity": {
    "moved_object": ["Preserved", "Changed"],
    "destination_binding": ["Created", "Preserved", "Replaced"]
  },
  "boundary_reasons": ["Closed", "Synced", "RenamedIntoPlace"],
  "boundary_observations": ["None", "Candidate", "Unsupported"],
  "producers": [
    {
      "reason": "Closed",
      "producer": "mesh-fuse/last-modified-handle-closed"
    },
    {
      "reason": "Synced",
      "producer": "mesh-fuse/successful-fsync"
    },
    {
      "reason": "RenamedIntoPlace",
      "producer": "mesh-fuse/atomic-replace-with-binding-evidence"
    }
  ],
  "ordering": {
    "view": "EventSequence-ascending",
    "concurrent": ["lamport", "event_ulid", "content_hash"],
    "wall_clock": "forbidden"
  },
  "compatibility": {
    "adapter_0": "frozen-readable",
    "adapter_1": "explicit-opt-in",
    "unknown_contract": "refuse",
    "silent_translation": "forbidden"
  }
}
