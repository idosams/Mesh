              "sequence": 5,
              "parents": [
                "0404040404040404040404040404040404040404040404040404040404040404"
              ],
              "base_head": "0404040404040404040404040404040404040404040404040404040404040404",
              "resulting_head": "0505050505050505050505050505050505050505050505050505050505050505",
              "policy_epoch": 0,
