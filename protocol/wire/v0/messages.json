{
  "wire_format": "mesh-cwp-wire/0",
  "record_encoding_profile": "mesh-cbor/0",
  "protocol_version": 0,
  "summary": "Every CWP message, its wire tag, its plane, its fields in encoding order, and one complete example of each with its exact bytes. Read protocol/wire/README.md first.",
  "frame": "A message is a two-element array: the wire tag, then the fields as an array in the order listed under `fields`.",
  "identifier_byte_length": 32,
  "limits": {
    "max_operations_per_batch": 256,
    "max_chunk_part_bytes": 1048576
  },
  "planes": [
    {
      "name": "handshake",
      "meaning": "Session establishment and refusal. Neither plane's latency budget covers it."
    },
    {
      "name": "metadata",
      "meaning": "Heads, ChangeSets, manifests, availability — everything except chunk bytes."
    },
    {
      "name": "content",
      "meaning": "Chunk bytes, resumable and verified on receipt."
    }
  ],
  "presence_states": [
    {
      "name": "active",
      "tag": 1
    },
    {
      "name": "idle",
      "tag": 2
    },
    {
      "name": "away",
      "tag": 3
    }
  ],
  "error_codes": [
    {
      "name": "unsupported version",
      "tag": 1,
      "retryable": false
    },
    {
      "name": "unknown message",
      "tag": 2,
      "retryable": false
    },
    {
      "name": "unauthenticated session",
      "tag": 3,
      "retryable": false
    },
    {
      "name": "unverified peer",
      "tag": 4,
      "retryable": false
    },
    {
      "name": "malformed message",
      "tag": 5,
      "retryable": false
    },
    {
      "name": "unknown actor",
      "tag": 6,
      "retryable": false
    },
    {
      "name": "sequence gap",
      "tag": 7,
      "retryable": false
    },
    {
      "name": "unknown ChangeSet",
      "tag": 8,
      "retryable": false
    },
    {
      "name": "unknown chunk",
      "tag": 9,
      "retryable": false
    },
    {
      "name": "offset past end",
      "tag": 10,
      "retryable": false
    },
    {
      "name": "integrity failure",
      "tag": 11,
      "retryable": false
    },
    {
      "name": "unknown policy epoch",
      "tag": 12,
      "retryable": true
    },
    {
      "name": "batch too large",
      "tag": 13,
      "retryable": false
    },
    {
      "name": "busy",
      "tag": 14,
      "retryable": true
    }
  ],
  "messages": [
    {
      "name": "HELLO",
      "tag": 1,
      "plane": "handshake",
      "summary": "Opens a session and states which protocol version and record encoding profile the sender speaks.",
      "fields": [
        {
          "name": "protocol_version",
          "type": "unsigned"
        },
        {
          "name": "encoding_profile",
          "type": "text"
        },
        {
          "name": "actor",
          "type": "bytes",
          "byte_length": 32,
          "note": "A claim, not evidence. AUTHENTICATE is what turns it into evidence."
        },
        {
          "name": "challenge",
          "type": "bytes",
          "byte_length": 32
        }
      ],
      "preconditions": [
        "protocol_version equals the receiver's, else `unsupported version`.",
        "encoding_profile equals `mesh-cbor/0`, else `unsupported version`."
      ],
      "vector": {
        "name": "hello-example",
        "value": {
          "protocol_version": 0,
          "encoding_profile": "mesh-cbor/0",
          "actor": "1111111111111111111111111111111111111111111111111111111111111111",
          "challenge": "2222222222222222222222222222222222222222222222222222222222222222"
        },
        "bytes_hex": "820184006b6d6573682d63626f722f305820111111111111111111111111111111111111111111111111111111111111111158202222222222222222222222222222222222222222222222222222222222222222",
        "byte_length": 84
      }
    },
    {
      "name": "AUTHENTICATE",
      "tag": 2,
      "plane": "handshake",
      "summary": "Offers a signature over the peer's challenge.",
      "fields": [
        {
          "name": "actor",
          "type": "bytes",
          "byte_length": 32
        },
        {
          "name": "challenge",
          "type": "bytes",
          "byte_length": 32
        },
        {
          "name": "signature",
          "type": "bytes"
        }
      ],
      "preconditions": [
        "signature is non-empty, else `malformed message`.",
        "HELLO came first on this session, and named the same actor."
      ],
      "vector": {
        "name": "authenticate-example",
        "value": {
          "actor": "1111111111111111111111111111111111111111111111111111111111111111",
          "challenge": "2222222222222222222222222222222222222222222222222222222222222222",
          "signature": "33333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333"
        },
        "bytes_hex": "8202835820111111111111111111111111111111111111111111111111111111111111111158202222222222222222222222222222222222222222222222222222222222222222584033333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333",
        "byte_length": 137
      }
    },
    {
      "name": "ADVERTISE_FRONTIER",
      "tag": 3,
      "plane": "metadata",
      "summary": "Offers every actor head the sender holds, with how much of each actor's sequence it holds contiguously.",
      "fields": [
        {
          "name": "heads",
          "type": "sequence",
          "element": {
            "name": "element",
            "type": "group",
            "fields": [
              {
                "name": "actor",
                "type": "bytes",
                "byte_length": 32
              },
              {
                "name": "head",
                "type": "bytes",
                "byte_length": 32
              },
              {
                "name": "contiguous_through",
                "type": "unsigned"
              },
              {
                "name": "sparse",
                "type": "sequence",
                "element": {
                  "name": "element",
                  "type": "group",
                  "fields": [
                    {
                      "name": "sequence",
                      "type": "unsigned"
                    },
                    {
                      "name": "id",
                      "type": "bytes",
                      "byte_length": 32
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "canonical_head",
          "type": "sequence",
          "max_elements": 1,
          "element": {
            "name": "element",
            "type": "bytes",
            "byte_length": 32
          },
          "note": "Absent is the empty sequence; present is a one-element sequence."
        },
        {
          "name": "policy_epoch",
          "type": "unsigned"
        }
      ],
      "preconditions": [
        "heads ascend by actor, so two peers holding the same set send the same bytes.",
        "each sparse set ascends by sequence and lies strictly beyond contiguous_through, else `sequence gap`."
      ],
      "vector": {
        "name": "advertise-frontier-example",
        "value": {
          "heads": [
            {
              "actor": "1111111111111111111111111111111111111111111111111111111111111111",
              "head": "4444444444444444444444444444444444444444444444444444444444444444",
              "contiguous_through": 3,
              "sparse": [
                {
                  "sequence": 9,
                  "id": "5555555555555555555555555555555555555555555555555555555555555555"
                }
              ]
            },
            {
              "actor": "6666666666666666666666666666666666666666666666666666666666666666",
              "head": "7777777777777777777777777777777777777777777777777777777777777777",
              "contiguous_through": 1,
              "sparse": []
            }
          ],
          "canonical_head": [
            "8888888888888888888888888888888888888888888888888888888888888888"
          ],
          "policy_epoch": 2
        },
        "bytes_hex": "",
        "byte_length": 218
      }
    },
    {
      "name": "REQUEST_OPERATIONS",
      "tag": 4,
      "plane": "metadata",
      "summary": "Asks for ChangeSets: a resume point in one actor's sequence, plus any specific ChangeSets wanted regardless of sequence.",
      "fields": [
        {
          "name": "actor",
          "type": "bytes",
          "byte_length": 32
        },
        {
          "name": "from_sequence",
          "type": "unsigned"
        },
        {
          "name": "specific",
          "type": "sequence",
          "element": {
            "name": "element",
            "type": "bytes",
            "byte_length": 32
          }
        },
        {
          "name": "max_count",
          "type": "unsigned"
        }
      ],
      "preconditions": [
        "max_count is non-zero, else `malformed message`.",
        "specific ascends and holds no duplicate."
      ],
      "vector": {
        "name": "request-operations-example",
        "value": {
          "actor": "1111111111111111111111111111111111111111111111111111111111111111",
          "from_sequence": 3,
          "specific": [
            "5555555555555555555555555555555555555555555555555555555555555555",
            "9999999999999999999999999999999999999999999999999999999999999999"
          ],
          "max_count": 64
        },
        "bytes_hex": "82048458201111111111111111111111111111111111111111111111111111111111111111038258205555555555555555555555555555555555555555555555555555555555555555582099999999999999999999999999999999999999999999999999999999999999991840",
        "byte_length": 109
      }
    },
    {
      "name": "OPERATIONS_BATCH",
      "tag": 5,
      "plane": "metadata",
      "summary": "Carries ChangeSets, each as its canonical bytes plus the fields a receiver needs before decoding them.",
      "fields": [
        {
          "name": "changesets",
          "type": "sequence",
          "element": {
            "name": "element",
            "type": "group",
            "fields": [
              {
                "name": "id",
                "type": "bytes",
                "byte_length": 32
              },
              {
                "name": "author",
                "type": "bytes",
                "byte_length": 32
              },
              {
                "name": "sequence",
                "type": "unsigned"
              },
              {
                "name": "parents",
                "type": "sequence",
                "element": {
                  "name": "element",
                  "type": "bytes",
                  "byte_length": 32
                }
              },
              {
                "name": "base_head",
                "type": "bytes",
                "byte_length": 32
              },
              {
                "name": "resulting_head",
                "type": "bytes",
                "byte_length": 32
              },
              {
                "name": "policy_epoch",
                "type": "unsigned"
              },
              {
                "name": "body",
                "type": "bytes",
                "note": "The ChangeSet's mesh-cbor/0 bytes, exactly as its author signed them."
              }
            ]
          }
        }
      ],
      "preconditions": [
        "changesets is non-empty.",
        "at most 256 elements, else `batch too large`.",
        "every body is non-empty and no sequence is zero, else `malformed message`."
      ],
      "vector": {
        "name": "operations-batch-example",
        "value": {
